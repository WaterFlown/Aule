code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D RockTexture : hint_default_black;
uniform sampler2D FloorTexture;
uniform float GroundMaskOffset : hint_range(-1.0, 1.0) = 0.69999998807907;
uniform float GroundMaskFade : hint_range(0.0, 1.0) = 0.30000001192093;



void fragment() {
	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(RockTexture, UV);


	vec4 n_out21p0;
// Texture2D:21
	n_out21p0 = texture(FloorTexture, UV);


// FloatParameter:10
	float n_out10p0 = GroundMaskOffset;


// FloatParameter:11
	float n_out11p0 = GroundMaskFade;


// FloatOp:7
	float n_out7p0 = n_out10p0 - n_out11p0;


// FloatOp:8
	float n_out8p0 = n_out10p0 + n_out11p0;


// Input:12
	vec3 n_out12p0 = NORMAL;


// Input:14
	mat4 n_out14p0 = VIEW_MATRIX;


// TransformVectorMult:13
	vec3 n_in13p1 = vec3(0.00000, 1.00000, 0.00000);
	vec3 n_out13p0 = (n_out14p0 * vec4(n_in13p1, 0.0)).xyz;


// DotProduct:9
	float n_out9p0 = dot(n_out12p0, n_out13p0);


// SmoothStep:6
	float n_out6p0 = smoothstep(n_out7p0, n_out8p0, n_out9p0);


// SmoothStep:5
	float n_in5p0 = 0.00000;
	float n_in5p1 = 1.00000;
	float n_out5p0 = smoothstep(n_in5p0, n_in5p1, n_out6p0);


// Mix:2
	vec3 n_out2p0 = mix(vec3(n_out18p0.xyz), vec3(n_out21p0.xyz), n_out5p0);


// IntConstant:15
	int n_out15p0 = 0;


// Output:0
	ALBEDO = n_out2p0;
	SPECULAR = float(n_out15p0);


}
